<Project Sdk="Microsoft.NET.Sdk">
  <!-- AutoCAD 2024 хүртэл (.NET Framework): dotnet build -c Release
       AutoCAD 2025+ (.NET 8):               dotnet build -c Release -p:AcadNet8=true  -> bin\Release\acad2025\ -->
  <PropertyGroup>
    <TargetFramework Condition="'$(AcadNet8)'!='true'">net48</TargetFramework>
    <TargetFramework Condition="'$(AcadNet8)'=='true'">net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SheetMerge</RootNamespace>
    <AssemblyName>SheetMerge.Acad</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(AcadNet8)'=='true'">bin\$(Configuration)\acad2025\</OutputPath>
    <IntermediateOutputPath Condition="'$(AcadNet8)'=='true'">obj\$(Configuration)\acad2025\</IntermediateOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AcadDir Condition="'$(AcadDir)'==''">C:\Program Files\Autodesk\AutoCAD 2020</AcadDir>
  </PropertyGroup>
  <!-- accoreconsole-д ажиллахын тулд зөвхөн core DLL-үүдийг ашиглана (acmgd биш) -->
  <ItemGroup Condition="'$(AcadNet8)'!='true'">
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="accoremgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- AutoCAD 2025 (.NET 8)-ийн API; 2026, 2027 дээр ч ачаалагдана -->
  <ItemGroup Condition="'$(AcadNet8)'=='true'">
    <PackageReference Include="AutoCAD.NET.Core" Version="[25.0.0]" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET.Model" Version="[25.0.0]" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
